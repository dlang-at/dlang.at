{
	"name": "dlang-at",
	"description": "Web application powering dlang.at",

	"license": "BSL-1.0",
	"copyright": "Copyright © 2025  Elias Batek",

	"authors": [
		"Mindy Batek (0xEAB)"
	],

	"targetPath": "bin",

	"sourcePaths": ["src"],
	"importPaths": ["src"],
	"stringImportPaths": ["src/data"],

	"excludedSourceFiles": ["src/arsd/*"],

	"dependencies": {
		"arsd-official:cgi": "~>12.1.1",
		"arsd-official:ini": "*"
	},

	"configurations": [
		{
			"name": "http",
			"subConfigurations": {
				"arsd-official:cgi": "embedded_httpd"
			},
			"targetType": "executable"
		},
		{
			"name": "cgi",
			"copyFiles": [
				"deploy/apache-httpd-cgi/.htaccess"
			],
			"subConfigurations": {
				"arsd-official:cgi": "cgi"
			},
			"targetName": "index.cgi",
			"targetType": "executable",
			"versions": ["plain_cgi"]
		},
		{
			"name": "lib",
			"targetType": "library",
			"excludedSourceFiles": ["src/app.d"]
		}
	],

	"buildTypes": {
		"CI-CD": {
			"buildOptions": ["inline", "optimize"],
			"buildRequirements": ["requireBoundsCheck"]
		}
	}
}
